# OpenRouter (copy and image generation)
OPENROUTER_API_KEY=

# Meta Marketing API (launching ads)
# Access token with ads_management permission
META_ACCESS_TOKEN=
# Ad account id, with the act_ prefix
META_AD_ACCOUNT_ID=
# Facebook Page the ads run from
META_PAGE_ID=
# Optional: Instagram account to run ads as
META_INSTAGRAM_ACTOR_ID=
